---
import { ISOTYPE_LEFT, ISOTYPE_RIGHT, ISOTYPE_VIEWBOX } from '../scripts/editorial-isotype';

// The ASO isotype drawn as separate parts so the hero can animate them. Geometry and colours are the official
// isotype (src/assets/brand/isotype-white.svg); the parts are only split, never redrawn or recolored.
// viewBox "278 165 186 209": the cursor bar (underscore) is centred at (119.6, 123.6) in viewBox units.
---

<svg class="hero-mark-svg" viewBox={ISOTYPE_VIEWBOX} aria-hidden="true" focusable="false">
	<g class="mark-outline" data-mark-outline>
		<path d={ISOTYPE_LEFT} />
		<path d={ISOTYPE_RIGHT} />
	</g>
	<path data-mark-left d={ISOTYPE_LEFT} fill="#ffffff" stroke="#ffffff" stroke-miterlimit="10" />
	<path data-mark-right d={ISOTYPE_RIGHT} fill="#2bb2e4" stroke="#2ab9f1" stroke-miterlimit="10" />
	<path
		data-mark-chev
		d="M358.784 270.584 L335.935 281.475 C335.935 281.475 330.675 284.563 333.385 289.355 C336.096 294.147 341.691 292.087 341.691 292.087 L376.724 275.114 C376.724 275.114 378.428 274.347 378.363 270.154 C378.306 266.531 378.152 266.2 374.965 264.705 C371.776 263.21 341.738 248.34 341.738 248.34 C341.738 248.34 336.362 247.817 334.966 250.614 C333.511 253.526 333.33 256.404 335.833 257.702 C338.337 259 358.784 270.584 358.784 270.584 Z"
		fill="#ffffff"
		stroke="#ffffff"
		stroke-miterlimit="10"
	/>
	<path
		data-mark-cursor
		d="M386.647 283.463 L408.614 283.463 C411.464 283.463 413.774 285.774 413.774 288.624 L413.774 288.624 C413.774 291.474 411.464 293.785 408.614 293.785 L386.647 293.785 C383.797 293.785 381.487 291.474 381.487 288.624 L381.487 288.624 C381.487 285.774 383.797 283.463 386.647 283.463 Z"
		fill="#ffffff"
		stroke="#ffffff"
		stroke-miterlimit="10"
	/>
</svg>
