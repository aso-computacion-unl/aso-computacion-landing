---
import IsotypeColor from '../assets/brand/isotype-color.svg';
import { firstCommit, socials } from '../data/site';

const instagram = socials.find((social) => social.remote === 'instagram');
---

<section id="primer-commit" class="relative bg-navy-deep py-24 lg:py-32">
	<div class="wrap">
		<div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
			<div>
				<h2 class="h2-xl">{firstCommit.title}</h2>
				{firstCommit.demo && <span class="demo-tag mt-4" style="margin-left:0" title="Contenido de ejemplo">demo</span>}
				<p class="mt-6 max-w-[40ch] text-lg text-mist lg:text-xl">{firstCommit.lead}</p>
			</div>
			<div class="relative flex items-center gap-8">
				{
					instagram && (
						<a
							href={instagram.href}
							target="_blank"
							rel="me noopener"
							class="inline-flex h-14 items-center rounded-[4px] bg-sky px-8 text-lg font-semibold text-navy hover:bg-white"
						>
							{firstCommit.cta}
							<span class="sr-only"> (se abre en otra pestaña)</span>
						</a>
					)
				}
				<span
					class="hidden size-24 shrink-0 rotate-[-8deg] place-items-center rounded-[4px] bg-white p-4 sm:grid"
					aria-hidden="true"
				>
					<IsotypeColor class="h-full w-auto" />
				</span>
			</div>
		</div>

		<ol class="relative mt-14 grid gap-10 lg:mt-20 lg:grid-cols-3 lg:gap-12">
			<span class="absolute left-0 right-0 top-[0.4375rem] hidden h-0.5 bg-sky lg:block" aria-hidden="true"></span>
			{
				firstCommit.steps.map((step) => (
					<li class="relative pl-10 lg:pl-0 lg:pt-12">
						<span
							class="absolute left-0 top-1 size-4 rounded-full border-[3px] border-navy-deep bg-sky lg:top-0 lg:size-[1.125rem]"
							aria-hidden="true"
						/>
						<h3 class="font-display text-xl leading-snug text-white lg:text-2xl">{step.title}</h3>
						<p class="mt-3 max-w-[40ch] text-lg text-mist">{step.text}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
