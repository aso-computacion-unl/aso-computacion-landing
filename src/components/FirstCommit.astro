---
import { firstCommit, socials } from '../data/site';

const instagram = socials.find((social) => social.remote === 'instagram');
---

<section id="primer-commit" class="bg-navy-deep py-20 lg:py-28">
	<div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-6 lg:grid-cols-[22rem_minmax(0,1fr)] lg:gap-16">
		<div>
			<h2 class="font-display text-3xl lg:text-4xl">{firstCommit.title}</h2>
			{firstCommit.demo && <span class="demo-tag mt-4" style="margin-left:0" title="Contenido de ejemplo">demo</span>}
			<p class="mt-5 max-w-[34ch] text-lg text-mist">{firstCommit.lead}</p>
			{
				instagram && (
					<a
						href={instagram.href}
						target="_blank"
						rel="me noopener"
						class="mt-8 inline-flex h-12 items-center rounded-[4px] bg-sky px-6 font-semibold text-navy hover:bg-white"
					>
						{firstCommit.cta}
						<span class="sr-only"> (se abre en otra pestaña)</span>
					</a>
				)
			}
		</div>

		<ol class="relative max-w-2xl before:absolute before:bottom-3 before:left-[0.4375rem] before:top-3 before:w-0.5 before:bg-sky">
			{
				firstCommit.steps.map((step) => (
					<li class="relative pb-10 pl-12 last:pb-0 last:after:absolute last:after:bottom-0 last:after:left-0 last:after:top-3 last:after:w-4 last:after:bg-navy-deep">
						<span
							class="absolute left-0 top-1 z-10 size-4 rounded-full border-[3px] border-navy-deep bg-sky"
							aria-hidden="true"
						/>
						<h3 class="font-display text-xl leading-snug text-white">{step.title}</h3>
						<p class="mt-2 max-w-[52ch] text-mist">{step.text}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
