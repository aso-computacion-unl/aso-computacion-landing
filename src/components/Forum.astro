---
// The forum's door on the landing (S7): an app window and, beside it, the sign-in ticket. The window has a title bar,
// the category chips with their counts (they filter the example threads), a composer that types the forum's own prompts,
// the threads (a coloured avatar letter and a category chip each) and a footer with the totals and the way to every
// thread. The forum itself lives on the admin's origin (`forum.url`, built in src/data/content.ts); without a known admin
// origin the way in is left out and the titles are plain text. The threads are demo content, tagged as such through the
// section head. Everything is in the markup already; src/scripts/forum-window.ts only makes the chips filter and the
// composer type. The look is in src/styles/sections.css.
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { ALL, categoryCounts } from '../scripts/forum-window';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { forum, site } = getContent(locale);

const THREADS = 3;
const threads = forum.threads.slice(0, THREADS);
const categoryName = (id: string) => forum.categories.find((category) => category.id === id)?.name ?? id;
const counts = categoryCounts(
	threads.map((thread) => thread.category),
	forum.categories.map((category) => category.id),
);
const chips = [
	{ id: ALL, name: t('forum.all'), count: counts[ALL] },
	...forum.categories.map((category) => ({ id: category.id, name: category.name, count: counts[category.id] })),
];
// What the composer types: the section's own line first (it is what the markup shows), then each category's description.
const prompts = [forum.lead, ...forum.categories.map((category) => category.description)];
const stats = t(threads.length === 1 ? 'forum.statsOne' : 'forum.stats', {
	threads: threads.length,
	categories: forum.categories.length,
});
---

<section id="foro" class="bg-navy py-section">
	<div class="wrap">
		<SectionHead eyebrow={forum.eyebrow} title={forum.title} lead={forum.lead} demo={forum.demo} />

		<div class="forum-teaser mt-head">
			<div class="forum-threads">
				<div class="forum-app" data-forum-app data-forum-prompts={JSON.stringify(prompts)}>
					<div class="forum-bar" aria-hidden="true">
						<i></i>
						<i></i>
						<i></i>
						<span>{t('forum.window', { name: site.name })}</span>
					</div>

					<div class="forum-tabs" role="group" aria-label={t('forum.filters')}>
						{chips.map((chip) => (
							<button
								type="button"
								class="forum-chip"
								data-forum-chip={chip.id}
								aria-pressed={chip.id === ALL ? 'true' : 'false'}
								disabled={chip.count === 0}
							>
								{chip.name}
								<span class="ct">{chip.count}</span>
							</button>
						))}
					</div>
					<p class="sr-only" aria-live="polite" data-forum-status data-template={t('forum.shown')}></p>

					<div class="forum-compose">
						<div class="field">
							<span class="typed" data-forum-typed aria-hidden="true">
								{prompts[0]}
							</span>
							{forum.url && <span class="caret" aria-hidden="true" />}
							{/* The link covers the field and holds only its name, so the typing never has to match it. */}
							{forum.url && (
								<a class="field-link" href={forum.url} target="_blank" rel="me noopener">
									<span class="sr-only">
										{t('forum.compose')} {t('newTab')}
									</span>
								</a>
							)}
						</div>
						{forum.url && (
							<a class="new" href={forum.url} target="_blank" rel="me noopener">
								{t('forum.new')}
								<span class="sr-only">{t('newTab')}</span>
							</a>
						)}
					</div>

					<ul class="forum-list" aria-label={t('forum.threads')}>
						{threads.map((thread) => {
							const kind = categoryName(thread.category);
							return (
								<li data-forum-row={thread.category}>
									{forum.url ? (
										<a class="forum-link" href={forum.url} target="_blank" rel="me noopener" data-k={thread.category}>
											<span class="av" aria-hidden="true">
												{kind.charAt(0)}
											</span>
											<span class="forum-title">{thread.title}</span>
											<span class="forum-kind">{kind}</span>
											<span class="forum-arrow" aria-hidden="true">
												→
											</span>
											<span class="sr-only">{t('newTab')}</span>
										</a>
									) : (
										<div class="forum-link" data-k={thread.category}>
											<span class="av" aria-hidden="true">
												{kind.charAt(0)}
											</span>
											<span class="forum-title">{thread.title}</span>
											<span class="forum-kind">{kind}</span>
										</div>
									)}
								</li>
							);
						})}
					</ul>

					{forum.url ? (
						<a class="forum-foot" href={forum.url} target="_blank" rel="me noopener">
							<small>{stats}</small>
							<span class="go">
								{t('forum.seeAll')}
								<i aria-hidden="true">→</i>
							</span>
							<span class="sr-only">{t('newTab')}</span>
						</a>
					) : (
						<p class="forum-foot">
							<small>{stats}</small>
						</p>
					)}
				</div>
			</div>

			<section class="forum-door" aria-labelledby="forum-signin">
				<div class="forum-door-top">
					<h3 id="forum-signin" class="forum-door-title">
						{t('forum.signin.title')}
					</h3>
					<p class="forum-door-text">{t('forum.signin.text')}</p>
					<ol class="door-perks">
						{(['forum.perk.1', 'forum.perk.2', 'forum.perk.3'] as const).map((key, index) => (
							<li>
								<b aria-hidden="true">{String(index + 1).padStart(2, '0')}</b>
								{t(key)}
							</li>
						))}
					</ol>
					<ul class="door-cats" aria-label={t('forum.filters')}>
						{forum.categories.map((category) => (
							<li data-k={category.id}>{category.name}</li>
						))}
					</ul>
				</div>
				<div class="forum-door-perf" aria-hidden="true"></div>
				<div class="forum-door-stub">
					{forum.url && (
						<Button href={forum.url} variant="paper" external>
							<span class="forum-google">
								<span class="forum-g" aria-hidden="true">
									<svg width="18" height="18" viewBox="0 0 24 24">
										<path
											fill="#4285F4"
											d="M23 12.3c0-.8-.1-1.5-.2-2.2H12v4.3h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7c2.2-2 3.4-4.9 3.4-8.5z"
										/>
										<path
											fill="#34A853"
											d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3A11.5 11.5 0 0012 24z"
										/>
										<path fill="#FBBC05" d="M5.6 14.7a6.9 6.9 0 010-4.4v-3H1.8a11.5 11.5 0 000 10.4z" />
										<path
											fill="#EA4335"
											d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.5 11.5 0 001.8 7.3l3.8 3A6.9 6.9 0 0112 4.8z"
										/>
									</svg>
								</span>
								{t('forum.signin.button')}
							</span>
						</Button>
					)}
					<p class="forum-note">
						{t('forum.signin.only')} <strong>@unl.edu.ec</strong>.
					</p>
				</div>
			</section>
		</div>
	</div>
</section>

<script>
	// Pages without the window never download the script.
	if (document.querySelector('[data-forum-app]')) void import('../scripts/forum-window');
</script>
