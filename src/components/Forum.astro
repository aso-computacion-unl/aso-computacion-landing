---
// The forum's door on the landing: a teaser. Three example thread titles beside the sign-in card, the only way in, and a
// button that sends to the forum for the rest. The forum itself lives on the admin's origin (`forum.url`, built in
// src/data/content.ts); without a known admin origin the way in is left out and the titles are plain text. The threads
// are demo content, tagged as such through the section head.
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { forum } = getContent(locale);

const THREADS = 3;
const threads = forum.threads.slice(0, THREADS);
const categoryName = (id: string) => forum.categories.find((category) => category.id === id)?.name ?? id;
---

<section id="foro" class="bg-navy py-section">
	<div class="wrap">
		<SectionHead eyebrow={forum.eyebrow} title={forum.title} lead={forum.lead} demo={forum.demo} />

		<div class="forum-teaser mt-head">
			<div class="forum-threads">
				<ul class="forum-list" aria-label={t('forum.threads')}>
					{threads.map((thread) => (
						<li>
							{forum.url ? (
								<a class="forum-link" href={forum.url} target="_blank" rel="me noopener">
									<span class="forum-kind">{categoryName(thread.category)}</span>
									<span class="forum-title">{thread.title}</span>
									<span class="forum-arrow" aria-hidden="true">
										→
									</span>
									<span class="sr-only">{t('newTab')}</span>
								</a>
							) : (
								<div class="forum-link">
									<span class="forum-kind">{categoryName(thread.category)}</span>
									<span class="forum-title">{thread.title}</span>
								</div>
							)}
						</li>
					))}
				</ul>
				{forum.url && (
					<Button href={forum.url} variant="ghost" external>
						{t('forum.seeAll')}
					</Button>
				)}
			</div>

			<section class="forum-door" aria-labelledby="forum-signin">
				<div class="forum-door-top">
					<h3 id="forum-signin" class="forum-door-title">
						{t('forum.signin.title')}
					</h3>
					<p class="forum-door-text">{t('forum.signin.text')}</p>
				</div>
				<div class="forum-door-perf" aria-hidden="true"></div>
				<div class="forum-door-stub">
					{forum.url && (
						<Button href={forum.url} variant="paper" external>
							<span class="forum-google">
								<span class="forum-g" aria-hidden="true">
									<svg width="18" height="18" viewBox="0 0 24 24">
										<path
											fill="#4285F4"
											d="M23 12.3c0-.8-.1-1.5-.2-2.2H12v4.3h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7c2.2-2 3.4-4.9 3.4-8.5z"
										/>
										<path
											fill="#34A853"
											d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3A11.5 11.5 0 0012 24z"
										/>
										<path fill="#FBBC05" d="M5.6 14.7a6.9 6.9 0 010-4.4v-3H1.8a11.5 11.5 0 000 10.4z" />
										<path
											fill="#EA4335"
											d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3A11.5 11.5 0 001.8 7.3l3.8 3A6.9 6.9 0 0112 4.8z"
										/>
									</svg>
								</span>
								{t('forum.signin.button')}
							</span>
						</Button>
					)}
					<p class="forum-note">
						{t('forum.signin.only')} <strong>@unl.edu.ec</strong>.
					</p>
				</div>
			</section>
		</div>
	</div>
</section>

<style>
	/* The thread titles sit beside the taller sign-in card; the button at the bottom of their column fills the height. */
	.forum-teaser {
		display: grid;
		gap: 2rem;
		align-items: stretch;
	}

	@media (min-width: 64rem) {
		.forum-teaser {
			grid-template-columns: minmax(0, 1fr) 23.75rem;
			gap: 3rem;
		}
	}

	.forum-threads {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
	}

	.forum-threads :global(.btn) {
		align-self: flex-start;
		margin-top: auto;
	}

	.forum-list {
		list-style: none;
		border-top: 1px solid color-mix(in oklab, var(--color-sky) 24%, transparent);
	}

	.forum-list li {
		border-bottom: 1px solid color-mix(in oklab, var(--color-sky) 24%, transparent);
	}

	.forum-link {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.25rem 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.forum-kind {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		color: var(--color-mist);
	}

	.forum-title {
		font-size: var(--text-lead);
		font-stretch: 112%;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01em;
		overflow-wrap: anywhere;
	}

	.forum-arrow {
		color: var(--color-mist);
		transition: color 0.15s;
	}

	a.forum-link:hover .forum-title,
	a.forum-link:focus-visible .forum-title {
		text-decoration: underline;
		text-decoration-color: var(--color-sky);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.22em;
	}

	a.forum-link:hover .forum-arrow,
	a.forum-link:focus-visible .forum-arrow {
		color: var(--color-sky);
	}

	a.forum-link:focus-visible {
		outline: 2px solid var(--color-sky);
		outline-offset: 2px;
	}

	/* On a phone the category sits above the title, so the arrow stays beside the title. */
	@media (max-width: 39.9375rem) {
		.forum-link {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.25rem 1rem;
		}

		.forum-kind {
			grid-column: 1 / -1;
		}
	}
</style>
