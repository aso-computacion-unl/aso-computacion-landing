---
import { aboutHighlights, join, site } from '../data/site';

// Split the statement so the highlighted phrases can be drawn in sky blue.
const pattern = new RegExp(`(${aboutHighlights.join('|')})`);
const parts = site.about.split(pattern);
---

<section id="nosotros" class="deep bg-navy-deep py-24 lg:py-32">
	<div class="wrap">
		<h2 class="h2-xl">Nosotros</h2>

		<div class="mt-10 lg:mt-14">
			<p class="file-tab" aria-hidden="true">README.md</p>
			<div class="panel p-6 sm:p-10 lg:p-14">
				<p class="max-w-[46em] text-[clamp(1.375rem,2.5vw,2.75rem)] font-semibold leading-[1.25] text-white">
					{parts.map((part) => (aboutHighlights.includes(part) ? <span class="text-sky">{part}</span> : part))}
				</p>
			</div>
		</div>

		<div class="mt-14 lg:mt-20">
			<p class="file-tab" aria-hidden="true">CONTRIBUTING.md</p>
			<div class="panel p-6 sm:p-10 lg:p-14">
				<div class="flex flex-wrap items-center gap-3">
					<h3 class="font-display text-2xl text-white lg:text-3xl">Cómo sumarte</h3>
					{join.demo && <span class="demo-tag" style="margin-left:0" title="Contenido de ejemplo">demo</span>}
				</div>
				<ol class="mt-8 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-12 lg:gap-12">
					{
						join.steps.map((step, index) => (
							<li class="border-t-2 border-sky pt-4">
								<span
									class="block font-display text-[clamp(4.5rem,9vw,8.5rem)] leading-[0.95] text-sky"
									aria-hidden="true"
								>
									{index + 1}
								</span>
								<h4 class="mt-4 font-display text-xl text-white lg:text-2xl">{step.title}</h4>
								<p class="mt-2 max-w-[34ch] text-lg text-mist">{step.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</div>
</section>
