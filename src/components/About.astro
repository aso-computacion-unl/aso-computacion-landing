---
import Photo from './Photo.astro';
import Isotype from '../assets/brand/isotype-white.svg';
import { getContent } from '../data/content';
import { copy } from '../data/site';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { pillars } = getContent(locale);
const { manifesto } = copy[locale];
---

<section id="nosotros" class="bg-navy py-section">
	<div class="wrap">
		<p class="eyebrow" aria-hidden="true">
			<span>{t('about.eyebrow')}</span>
		</p>

		<h2 class="manifesto" data-manifesto>
			<span class="sr-only">{manifesto.sr}</span>
			<span aria-hidden="true">
				{manifesto.lines.map((line) => (
					<span class="m-line">
						<span class="m-in" data-m-in>
							{line}
						</span>
					</span>
				))}
				<span class="m-line">
					<span class="m-in" data-m-in>
						<span class="rotor" data-rotor>
							{manifesto.rotor.map((word) => (
								<span class="rotor-word">{word}</span>
							))}
						</span>
					</span>
				</span>
			</span>
		</h2>

		{pillars.length > 0 && (
			<ul class="bento mt-head">
				{pillars.map((pillar, index) => (
					<li class:list={['tile', `tile-${index}`]} data-tile>
						{pillar.image && (
							<div class="duo tile-photo">
								<Photo
									photo={pillar.image}
									box={{ width: 720, height: 540 }}
									widths={[480, 720]}
									sizes="(min-width: 1024px) 40rem, 90vw"
									loading="lazy"
								/>
							</div>
						)}
						{pillar.faces && <Isotype class="tile-iso" aria-hidden="true" />}
						<div class="tile-body">
							<span class="tile-word" aria-hidden="true" data-word>
								{pillar.word}
							</span>
							<h3 class="tile-title">{pillar.title}</h3>
							<p class="tile-text">{pillar.text}</p>
							{pillar.demo && (
								<span class="demo-tag" style="margin-left:0" title={t('demo.title')}>
									demo
								</span>
							)}
						</div>
					</li>
				))}
			</ul>
		)}
	</div>
</section>
