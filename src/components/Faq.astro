---
// The questions people ask most, as a plain accordion: one <details> per question, the plus/minus mark on the title row.
// The list is the admin's FAQ (src/data/content.ts); the question for a missing answer goes after it, to the forum.
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import SectionHead from './SectionHead.astro';
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { faq } = getContent(locale);
---

<section id="faq" class="bg-navy py-section">
	<div class="wrap">
		<SectionHead eyebrow={t('faq.eyebrow')} title={faq.title} lead={faq.lead} demo={faq.demo} />

		<div class="faq-list mt-head">
			{faq.items.map((item) => (
				<details class="faq-item" name="faq">
					<summary>
						<span class="faq-title">{item.q}</span>
						<span class="faq-plus" aria-hidden="true" />
					</summary>
					<div class="faq-a">
						<p>{item.a}</p>
					</div>
				</details>
			))}
		</div>

		<p class="faq-after">
			{t('faq.forumBefore')}
			<a href="#foro">
				{t('faq.forumLink')}
				<span aria-hidden="true">→</span>
			</a>
		</p>
	</div>
</section>
