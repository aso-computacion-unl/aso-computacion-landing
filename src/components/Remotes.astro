---
import { socials } from '../data/site';

const display = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<section id="redes" class="bg-navy py-16 sm:py-24 lg:py-32">
	<div class="wrap grid gap-10 lg:grid-cols-[minmax(20rem,26rem)_minmax(0,1fr)] lg:gap-16">
		<div>
			<h2 class="h2-xl">Síguenos</h2>
			<p class="mt-5 max-w-[34ch] text-lg text-mist">
				Todo se anuncia en redes, y por ahí mismo puedes escribirnos por mensaje directo.
			</p>
		</div>
		<div>
			<p class="file-tab" aria-hidden="true">$ git remote -v</p>
			<ul class="panel">
				{
					socials.map((social) => (
						<li class="border-t border-sky/25 first:border-t-0">
							<a
								href={social.href}
								target="_blank"
								rel="me noopener"
								class="group grid gap-1 px-5 py-4 hover:bg-sky sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:items-center sm:gap-5 sm:px-6"
							>
								<span class="font-mono text-[0.8125rem] text-sky group-hover:text-navy" aria-hidden="true">
									{social.remote}
								</span>
								<span>
									<span class="flex flex-wrap items-center gap-x-3 gap-y-1">
										<span class="font-semibold text-white group-hover:text-navy">{social.label}</span>
										{social.note && (
											<span class="bg-signal px-2 py-1 font-mono text-xs font-semibold leading-none text-white">
												{social.note}
											</span>
										)}
									</span>
									<span class="mt-0.5 block text-sm text-mist group-hover:text-navy">{social.handle}</span>
								</span>
								<span class="break-all font-mono text-xs text-mist group-hover:text-navy" aria-hidden="true">
									{display(social.href)}
								</span>
								<span class="sr-only">(se abre en otra pestaña)</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
