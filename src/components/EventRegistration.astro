---
// Registration block of an upcoming activity's card (S8): a link to the admin for UNL-account registration, or the
// landing's own form (name, email, career, semester + Cloudflare Turnstile) for the open mode, plus the `.ics` link.
// The form is a <details> that does nothing until it is opened: Turnstile is only loaded then (src/scripts/registration.ts).
// The deadline is checked at build time here and again in the browser, because the page is built ahead of time.
import { turnstileSiteKey } from '../data/content';
import type { TimelineEntry } from '../lib/admin-content/model';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { LIMITS } from '../lib/registration/fields';
import { formatDeadline, registrationClosed } from '../lib/registration/rules';

interface Props {
	entry: TimelineEntry;
}

const { entry } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { registration, calendarHref } = entry;
const id = `reg-${entry.id}`;
const closed = registration ? registrationClosed(registration.deadline, Date.now()) : false;
const unl = registration?.mode === 'unl';
const form = registration?.mode === 'open' && turnstileSiteKey !== undefined;
const showLive = !closed && (unl || form);

const fields = [
	{ name: 'name', type: 'text', autocomplete: 'name', max: LIMITS.name },
	{ name: 'email', type: 'email', autocomplete: 'email', max: LIMITS.email },
	{ name: 'career', type: 'text', autocomplete: 'off', max: LIMITS.career },
	{ name: 'semester', type: 'number', autocomplete: 'off', max: undefined },
] as const;
---

{(registration || calendarHref) && (
	<div class="reg" data-reg data-reg-deadline={registration?.deadline}>
		{registration && (showLive || closed) && (
			<>
				<p class="reg-closed" data-reg-closed hidden={!closed}>
					{t('registration.closedNote')}
				</p>
				{showLive && (
					<div class="reg-live" data-reg-live hidden={closed}>
						{unl && registration && (
							<>
								<a class="reg-cta" href={registration.href} target="_blank" rel="noopener">
									{t('registration.unl')}
									<span class="sr-only"> {t('newTab')}</span>
								</a>
								<p class="reg-note">{t('registration.unlHint')}</p>
							</>
						)}
						{form && registration && (
							<>
								<details class="reg-details js-only" data-reg-details>
									<summary class="reg-cta">{t('registration.open')}</summary>
									{/* The form must never submit natively: a GET would put what was typed in the URL. It is `post` with no action,
									    `onsubmit` refuses it, and the submit button stays disabled until src/scripts/registration.ts has attached its handler. */}
									<form
										class="reg-form"
										method="post"
										onsubmit="return false"
										novalidate
										data-reg-form
										data-endpoint={registration.href}
										data-site-key={turnstileSiteKey}
										aria-labelledby={`${id}-title`}
									>
										<p class="reg-form-title" id={`${id}-title`}>
											{t('registration.title', { title: entry.title })}
										</p>
										<p class="reg-note">{t('registration.required')}</p>
										{fields.map((field) => (
											<div class="reg-field">
												<label for={`${id}-${field.name}`}>{t(`registration.${field.name}`)}</label>
												<input
													id={`${id}-${field.name}`}
													name={field.name}
													type={field.type}
													autocomplete={field.autocomplete}
													maxlength={field.max}
													min={field.name === 'semester' ? LIMITS.semesterMin : undefined}
													max={field.name === 'semester' ? LIMITS.semesterMax : undefined}
													inputmode={field.name === 'semester' ? 'numeric' : undefined}
													required
													aria-describedby={`${id}-${field.name}-error`}
												/>
												<p class="reg-field-error" id={`${id}-${field.name}-error`} data-reg-field-error={field.name} />
											</div>
										))}
										<div
											class="reg-captcha"
											role="group"
											aria-label={t('registration.captchaLabel')}
											data-reg-captcha
										/>
										<p class="reg-note">{t('registration.privacy')}</p>
										<button type="submit" class="reg-submit" data-reg-submit disabled>
											{t('registration.submit')}
										</button>
										<p class="reg-message reg-message-error" role="alert" tabindex="-1" data-reg-error />
										<p class="reg-message reg-message-ok" role="status" tabindex="-1" data-reg-ok />
									</form>
								</details>
								<noscript>
									<p class="reg-note">{t('registration.noScript')}</p>
								</noscript>
							</>
						)}
					</div>
				)}
				{registration.capacity !== undefined && (
					<p class="reg-note">{t('registration.capacity', { count: registration.capacity })}</p>
				)}
				{registration.deadline && !closed && (
					<p class="reg-note">{t('registration.deadline', { date: formatDeadline(registration.deadline, locale) })}</p>
				)}
			</>
		)}
		{calendarHref && (
			<a class="reg-calendar" href={calendarHref}>
				{t('calendar.add')}
				<span aria-hidden="true"> · .ics</span>
			</a>
		)}
	</div>
)}

<script>
	// Pages with no registration block (most of them) download nothing but this line.
	if (document.querySelector('[data-reg]')) void import('../scripts/registration');
</script>
