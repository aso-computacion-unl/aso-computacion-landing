---
// One ticket of the Inscripciones section (S1, S2): white paper with the activity on top and, under the perforation,
// a sky stub with the seats, the deadline and the single action. `unl` and `open` both link to the admin's event page,
// where the student signs up (there is no form on the landing); `free` has no registration, only its calendar link.
// The page is built ahead of time, so what can change afterwards carries a data hook: src/scripts/ticket-deadline.ts
// closes the ticket when its deadline passes and keeps the days left honest, src/scripts/seats.ts paints the live
// seats and src/scripts/ticket.ts is what both do to a closed one. Each ticket takes one of three accents in turn
// (sky, signal, navy; `data-acc`), which src/styles/sections.css paints on its band, badge, date, labels and stub.
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { formatDeadline, registrationClosed } from '../lib/registration/rules';
import { closesIn, closesInLabel, ticketAnchor, type Ticket } from '../lib/registration/tickets';

interface Props {
	ticket: Ticket;
}

const { ticket } = Astro.props;
const { entry, mode, number } = ticket;
const { registration, calendarHref, meta } = entry;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const id = `reg-${entry.id}`;
const now = Date.now();
const closed = registration ? registrationClosed(registration.deadline, now) : false;
const left = registration && !closed ? closesIn(registration.deadline, now) : undefined;
const daysLeft = left ? closesInLabel(left.days) : undefined;
const capacity = registration?.capacity;

// "14 abr 2026": the day is the big numeral of the ticket and the rest its caption. A month-only date has no day, so the
// month takes its place; an undated activity has no date block.
const [big, ...rest] = (entry.stamp ?? '').split(' ');
const when = entry.stamp ? { big, rest: rest.join(' ') } : undefined;

const facts = [
	{ label: t('ticket.fact.time'), value: meta?.hora },
	{ label: t('ticket.fact.place'), value: meta?.lugar },
	{ label: t('ticket.fact.for'), value: meta?.para },
].filter((fact) => fact.value);

const accent = (number - 1) % 3;

const label = t('ticket.no', { n: String(number).padStart(3, '0') });
---

<li
	class="tk-item"
	id={ticketAnchor(entry.id)}
	data-acc={accent}
	data-ticket={mode === 'free' ? undefined : entry.id}
	data-reg={registration ? '' : undefined}
	data-reg-deadline={registration?.deadline}
>
	<article class:list={['tk', { 'tk-free': mode === 'free', 'is-closed': closed }]} aria-labelledby={`${id}-heading`}>
		<div class="tk-body">
			<p class="tk-top">
				<span class="tk-no">{label}</span>
				{mode !== 'free' && <span class="tk-chip">{t(`ticket.mode.${mode}`)}</span>}
				{entry.demo && (
					<span class="demo-tag" title={t('demo.title')}>
						demo
					</span>
				)}
			</p>
			{when && (
				<p class="tk-day">
					<time datetime={entry.date}>
						<b>{when.big}</b>
						<span>{when.rest}</span>
					</time>
				</p>
			)}
			<h3 class="tk-title" id={`${id}-heading`}>
				{entry.title}
			</h3>
			{facts.length > 0 && (
				<dl class="tk-facts">
					{facts.map((fact) => (
						<div>
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			)}
		</div>
		<div class="tk-perf" aria-hidden="true"></div>

		{registration ? (
			<div class="tk-stub">
				<div class="tk-seat">
					<p class="tk-seat-n" hidden={capacity === undefined}>
						<span data-seat-num>{capacity}</span>
						<small data-seat-label>{t(capacity === 1 ? 'ticket.seatOne' : 'ticket.seatMany')}</small>
						<span class="tk-live" data-seat-live hidden>
							{t('ticket.live')}
						</span>
					</p>
					<div class="tk-meter" role="img" data-seat-meter data-seat-slot>
						<i />
					</div>
					<p class="tk-cap" data-seat-taken data-seat-slot />
				</div>
				<p class="tk-state" data-ticket-state hidden={!closed}>
					{closed && t('ticket.closed')}
				</p>
				<a
					class:list={['btn', 'btn-paper', 'tk-action', { 'is-disabled': closed }]}
					href={closed ? undefined : registration.href}
					aria-disabled={closed ? 'true' : undefined}
					data-reg-action
				>
					<span class="btn-face">
						<span>
							{t('ticket.enroll')}
							<span class="sr-only">: {entry.title}</span>
						</span>
						<span class="btn-glyph" aria-hidden="true">
							→
						</span>
					</span>
				</a>
				<div class="tk-notes">
					{daysLeft && registration.deadline && (
						<p class="tk-dl" data-reg-extra>
							<span data-reg-closes>{t(daysLeft.key, daysLeft.vars)}</span>
							{' · '}
							{formatDeadline(registration.deadline, locale)}
						</p>
					)}
					{!closed && !registration.deadline && (
						<p class="tk-dl" data-reg-extra>
							{t('ticket.noDeadline')}
						</p>
					)}
					<p class="tk-dl" data-reg-extra hidden={closed}>
						{t(mode === 'unl' ? 'ticket.hint.unl' : 'ticket.hint.open')}
					</p>
				</div>
			</div>
		) : (
			<div class="tk-stub">
				<p class="tk-free-n">{t('ticket.freeEntry')}</p>
				<p class="tk-dl">{t('ticket.freeHint')}</p>
				{calendarHref && (
					<a class="tk-cal" href={calendarHref} title={t('ticket.calendarTitle')}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<rect x="3.5" y="5" width="17" height="15.5" stroke="currentColor" stroke-width="2" />
							<path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" />
						</svg>
						<span class="tk-cal-say">
							<b>{t('ticket.calendar')}</b>
							<small>{t('ticket.calendarApps')}</small>
						</span>
						<span class="sr-only">: {entry.title}</span>
					</a>
				)}
			</div>
		)}
	</article>
</li>

<script>
	// Pages with no ticket that takes registrations download nothing but this line.
	if (document.querySelector('[data-reg]')) void import('../scripts/ticket-deadline');
</script>
