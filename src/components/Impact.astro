---
import type { ImpactStat } from '../lib/admin-content/model';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

interface Props {
	stats: ImpactStat[];
}

const { stats } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
---

{stats.length > 0 && (
	<section id="impacto" class="deep bg-navy-deep py-16 sm:py-24 lg:py-32">
		<div class="wrap">
			<SectionHead eyebrow="$ git diff --stat" title={t('impact.title')} lead={t('impact.lead')} />

			<dl class="impact mt-12 lg:mt-16" aria-label={t('impact.list')}>
				{stats.map((stat) => (
					<div class="impact-stat">
						<dt class="impact-label">{stat.label}</dt>
						<dd class="impact-value">{stat.value}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>
)}
