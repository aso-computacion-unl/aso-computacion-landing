---
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { ribbonItems } from '../lib/registration/ribbon';
import { chooseTickets } from '../lib/registration/tickets';

const locale = toLocale(Astro.currentLocale);
const ribbon = ribbonItems(chooseTickets(getContent(locale).timeline), locale);
---

<div class="ribbon" aria-hidden="true">
	<div class="ribbon-band">
		<div class="ribbon-track">
			{[0, 1].map(() => (
				<div class="ribbon-group">
					{ribbon.map((text) => (
						<>
							<span>{text}</span>
							<span class="ribbon-dot" />
						</>
					))}
				</div>
			))}
		</div>
	</div>
</div>
