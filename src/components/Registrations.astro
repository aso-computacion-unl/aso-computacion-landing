---
// The Inscripciones section (S1, S2): one ticket per upcoming activity, nearest date first, for any number of activities
// and any dates. Which activities get one, and how each signs up, is decided in src/lib/registration/tickets.ts; the
// section is left out when there is none. The seats left are painted by src/scripts/seats.ts when the admin's origin
// is known (`data-seats-url`); signing up happens on the admin's event page, which each ticket links to.
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { chooseTickets } from '../lib/registration/tickets';
import LanguagesMoment from './LanguagesMoment.astro';
import SectionHead from './SectionHead.astro';
import Ticket from './Ticket.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { seatsUrl, timeline } = getContent(locale);
const tickets = chooseTickets(timeline);
const modes = (['unl', 'open', 'free'] as const).filter((mode) => tickets.some((ticket) => ticket.mode === mode));
const live = tickets.some((ticket) => ticket.mode !== 'free');
---

{tickets.length > 0 && (
	<section id="inscripciones" class="tk-section py-section" data-seats-url={live ? seatsUrl : undefined}>
		<div class="wrap">
			<SectionHead
				eyebrow={t('ticket.eyebrow')}
				title={t('ticket.title')}
				lead={t('ticket.lead')}
				demo={tickets.some((ticket) => ticket.entry.demo)}
			>
				<div slot="aside" class="tk-aside">
					<ul class="tk-key" aria-label={t('ticket.key')}>
						{modes.map((mode) => (
							<li>
								<b>{t(`ticket.key.${mode}`)}</b> · {t(`ticket.key.${mode}Text`)}
							</li>
						))}
					</ul>
					<LanguagesMoment />
				</div>
			</SectionHead>
			<ol class="tk-list" aria-label={t('ticket.list')}>
				{tickets.map((ticket) => (
					<Ticket ticket={ticket} />
				))}
			</ol>
		</div>
	</section>
)}

<script>
	// Pages that do not know the admin's origin (or have no ticket with registration) never ask for the seats.
	if (document.querySelector('[data-seats-url]')) void import('../scripts/seats');
</script>
