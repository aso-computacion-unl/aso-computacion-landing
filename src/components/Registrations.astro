---
// The Inscripciones section (S1, S2): one ticket per upcoming activity, nearest date first, for any number of activities
// and any dates. Which activities get one, and how each signs up, is decided in src/lib/registration/tickets.ts; the
// section is left out when there is none. The form that the `open` tickets unfold lives in EventRegistration.astro.
import { getContent, turnstileSiteKey } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { chooseTickets } from '../lib/registration/tickets';
import SectionHead from './SectionHead.astro';
import Ticket from './Ticket.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { timeline } = getContent(locale);
const tickets = chooseTickets(timeline, turnstileSiteKey);
const modes = (['unl', 'open', 'free'] as const).filter((mode) => tickets.some((ticket) => ticket.mode === mode));
---

{tickets.length > 0 && (
	<section id="inscripciones" class="tk-section py-16 sm:py-24 lg:py-32">
		<div class="wrap">
			<SectionHead
				eyebrow={t('ticket.eyebrow')}
				title={t('ticket.title')}
				lead={t('ticket.lead')}
				demo={tickets.some((ticket) => ticket.entry.demo)}
			>
				<ul slot="aside" class="tk-key" aria-label={t('ticket.key')}>
					{modes.map((mode) => (
						<li>
							<b>{t(`ticket.key.${mode}`)}</b> · {t(`ticket.key.${mode}Text`)}
						</li>
					))}
				</ul>
			</SectionHead>
			<ol class="tk-list" aria-label={t('ticket.list')}>
				{tickets.map((ticket) => (
					<Ticket ticket={ticket} />
				))}
			</ol>
		</div>
	</section>
)}
