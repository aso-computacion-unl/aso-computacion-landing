---
import Logo from '../assets/brand/logo-white-sky.svg';
import { site, socials, timeline } from '../data/site';
import Commit from './Commit.astro';

const instagram = socials.find((social) => social.remote === 'instagram');
// Preview of the timeline, upcoming first: the two nearest upcoming entries (in log order), then HEAD.
// Past activities live in the full activity graph below; the rail keeps running into them.
const head = timeline.find((entry) => entry.kind === 'head');
const headIndex = head ? timeline.indexOf(head) : timeline.length;
const upcoming = timeline.slice(0, headIndex).filter((entry) => entry.kind === 'upcoming').slice(-2);
const latest = [...upcoming, head].filter((entry) => entry !== undefined);
---

<section id="top" class="bg-navy lg:grid lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[minmax(0,1fr)_minmax(26rem,38%)]">
	<div
		class="px-5 pb-14 pt-10 sm:px-10 lg:flex lg:flex-col lg:justify-center lg:py-16 lg:pl-[max(2.5rem,calc((100vw-72rem)/2+1.5rem))] lg:pr-12"
	>
		<Logo class="w-56 sm:w-64 lg:w-[19rem]" role="img" aria-label={site.name} />
		<h1 class="mt-10 max-w-[20ch] font-display text-3xl leading-tight sm:text-4xl lg:text-[2.75rem]">
			{site.headline}
		</h1>
		<p class="mt-5 max-w-[46ch] text-lg text-mist">{site.description}</p>
		<div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
			<a
				href="#actividades"
				class="inline-flex h-12 items-center rounded-[4px] bg-sky px-6 font-semibold text-navy hover:bg-white"
			>
				Ver actividades
			</a>
			{
				instagram && (
					<a
						href={instagram.href}
						target="_blank"
						rel="me noopener"
						class="font-semibold text-white underline decoration-sky decoration-2 underline-offset-4 hover:text-sky"
					>
						Síguenos en Instagram
						<span class="sr-only"> (se abre en otra pestaña)</span>
					</a>
				)
			}
		</div>
	</div>

	<div class="deep flex flex-col bg-navy-deep px-5 pt-10 sm:px-10 lg:pr-10 lg:pt-16" aria-hidden="true">
		<p class="tag self-start">main</p>
		<div class="graph log mt-5 flex-1">
			<span class="rail rail-main" data-rail data-hero-rail></span>
			<ol data-hero-log>
				{latest.map((entry) => <Commit entry={entry} compact />)}
			</ol>
		</div>
	</div>
</section>
