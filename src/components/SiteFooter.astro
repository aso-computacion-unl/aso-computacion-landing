---
import LogoColor from '../assets/brand/logo-color.svg';
import LogoWhiteSky from '../assets/brand/logo-white-sky.svg';
import { getContent } from '../data/content';
import { contactEmail } from '../data/site';
import { localizedPath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { site } = getContent(locale);

// Who built the site, for anyone who wants to reach them: a credit, not a pitch.
const author = 'Alejandro Padilla';
const authorLinks = [
	{ label: t('footer.portfolio'), href: 'https://alejandrotatum.github.io/', external: true },
	{ label: 'GitHub', href: 'https://github.com/AlejandroTatum', external: true },
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/alejandro-emanuel-padilla-espinoza-58003b408/',
		external: true,
	},
	{ label: t('footer.email'), href: `mailto:${contactEmail}`, external: false },
];
const [before, after] = t('footer.madeBy').split('{name}');
---

<footer class="deep bg-navy-deep py-10">
	<div class="wrap grid gap-6 font-mono text-label text-mist">
		{/* The brand, big: the round logo makes one full turn as the page scrolls to its end (src/scripts/motion.ts). */}
		<div class="foot-brand" data-foot-brand aria-hidden="true">
			<span class="foot-logo" data-foot-logo>
				<LogoColor class="theme-light-only" />
				<LogoWhiteSky class="theme-dark-only" />
			</span>
			<span class="foot-word" data-foot-word>
				{site.name}
			</span>
		</div>
		<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
			<p>
				{site.name} · {t('footer.university')}
			</p>
			<p class="flex flex-wrap items-center gap-x-5">
				<span>© {new Date().getFullYear()}</span>
				<a href={localizedPath('/privacidad', locale)} class="credit-link">
					{t('footer.privacy')}
				</a>
			</p>
		</div>
		<div class="credit flex flex-col gap-3 pt-6 lg:flex-row lg:items-center lg:justify-between">
			<p>
				<span class="text-sky" aria-hidden="true">
					$ whoami
				</span>
				<span class="ml-2">
					{before}
					<span class="text-ink">{author}</span>
					{after}
				</span>
			</p>
			<ul class="flex flex-wrap gap-x-5" aria-label={t('footer.contact')}>
				{authorLinks.map((link) => (
					<li>
						<a href={link.href} class="credit-link" {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
							{link.label}
							{link.external && <span class="sr-only">{t('newTab')}</span>}
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</footer>

<style>
	.foot-brand {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.5rem);
		padding-bottom: 2.5rem;
		/* The wordmark slides in from the right: clip it so that start never widens the page. */
		overflow: clip;
		border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
	}

	.foot-logo {
		flex: none;
		width: clamp(5.5rem, 10vw, 9.5rem);
	}

	.foot-logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* The wordmark is Audiowide, the brand face; it shrinks to fit the row so a phone never scrolls sideways. Its size is a
	   fixed share of the section-title role on purpose: the nearest scale roles are too big for the row at 320px. */
	.foot-word {
		min-width: 0;
		font-family: var(--font-brand);
		font-size: calc(var(--text-giant) * 0.75);
		font-stretch: 100%;
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: 0;
		color: var(--color-ink);
		overflow-wrap: break-word;
	}

	.credit {
		border-top: 1px dashed color-mix(in srgb, var(--color-mist) 35%, transparent);
	}

	.credit-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		color: var(--color-mist);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--color-sky) 50%, transparent);
		text-underline-offset: 0.25em;
		transition: color 150ms ease;
	}

	.credit-link:hover,
	.credit-link:focus-visible {
		color: var(--color-sky);
	}
</style>
