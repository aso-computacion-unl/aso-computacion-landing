---
import { Image } from 'astro:assets';
import IsotypeColor from '../assets/brand/isotype-color.svg';
import { join, socials, team, timeline } from '../data/site';
import Button from './Button.astro';

const instagram = socials.find((social) => social.remote === 'instagram');
// Collage rows: the demo event photos on one row, the real board photos on the other. Both repeat so the rows are
// wider than the viewport and can slide against each other on scroll.
const eventPhotos = timeline.flatMap((entry) => (entry.image ? [entry.image] : []));
const rowA = [...eventPhotos, ...eventPhotos.slice(0, 3)];
const facePhotos = team.map((member) => member.photo);
const rowB = [...facePhotos, ...facePhotos.slice(0, 5)];
---

<section id="sumarte" class="on-sky relative overflow-clip bg-sky py-16 text-navy sm:py-24 lg:py-32">
	<div class="wrap">
		<div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16">
			<h2 class="join-title">
				{
					join.headline.map((line) => (
						<span class="m-line">
							<span class="m-in" data-j-in>{line}</span>
						</span>
					))
				}
			</h2>
			<div>
				{join.demo && <span class="demo-tag mb-5" style="margin-left:0" title="Contenido de ejemplo">demo</span>}
				<p class="max-w-[36ch] text-xl font-semibold leading-snug sm:text-2xl">{join.lead}</p>
			</div>
		</div>
	</div>

	<div class="collage mt-12 lg:mt-16" data-collage aria-hidden="true">
		<span class="stk" style="--r:-7deg;left:5%;top:-1.25rem"><span class="stk-face stk-white" data-pop>{join.stickers[0]}</span></span>
		<span class="stk" style="--r:5deg;right:6%;bottom:-1rem"><span class="stk-face stk-navy" data-pop>{join.stickers[1]}</span></span>
		<div class="c-row c-row-a" data-c-row="left">
			{
				rowA.map((photo) => (
					<div class="duo c-tile c-wide">
						<Image src={photo} alt="" width={480} height={340} widths={[320, 480]} sizes="17rem" loading="lazy" />
					</div>
				))
			}
		</div>
		<div class="c-row c-row-b" data-c-row="right">
			{
				rowB.map((photo) => (
					<div class="duo c-tile c-tall">
						<Image src={photo} alt="" width={288} height={336} fit="cover" position="top" widths={[192, 288]} sizes="12rem" loading="lazy" />
					</div>
				))
			}
		</div>
	</div>

	<div class="wrap">
		<ul class="mt-16 grid gap-x-14 md:grid-cols-2 lg:mt-24">
			{
				join.reasons.map((reason) => (
					<li class="reason" data-reason>
						<h3 class="reason-title">{reason.title}</h3>
						<p class="reason-text">{reason.text}</p>
					</li>
				))
			}
		</ul>

		<div class="newcomer relative mt-14 lg:mt-20">
			<span class="stk stk-iso" style="--r:-9deg" aria-hidden="true">
				<span class="stk-face stk-white" data-pop><IsotypeColor class="h-full w-auto" /></span>
			</span>
			<div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-14">
				<div>
					<h3 class="font-mono text-[0.8125rem] font-semibold text-sky">{join.newcomer.title}</h3>
					<p class="mt-3 font-display text-[clamp(1.75rem,3.4vw,3.5rem)] leading-[1.1] text-white">
						{join.newcomer.lead}
					</p>
					<div class="mt-5 grid max-w-[60ch] gap-3 text-lg text-mist">
						{join.newcomer.steps.map((step) => <p>{step}</p>)}
					</div>
				</div>
				<div class="lg:justify-self-end">
					{
						instagram && (
							<Button href={instagram.href} size="xl" external>
								{join.cta}
							</Button>
						)
					}
				</div>
			</div>
		</div>
	</div>
</section>
