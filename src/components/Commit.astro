---
import Photo from './Photo.astro';
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { metaLabel, useTranslations } from '../i18n/ui';
import type { TimelineKind } from '../lib/admin-content/model';
import { eventAnchor } from '../lib/seo/events';
import { ticketAnchor, ticketMode } from '../lib/registration/tickets';
import { shortHash } from './shortHash';

type Entry = ReturnType<typeof getContent>['timeline'][number];

interface Props {
	entry: Entry;
	last?: boolean;
	compact?: boolean;
	// The activity graph's tighter card: less padding, no hash line, the links in one row.
	dense?: boolean;
}

const { entry, last = false, compact = false, dense = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { nextEvent } = getContent(locale);

const nodeClass: Record<TimelineKind, string> = {
	next: 'node-next',
	upcoming: 'node-upcoming',
	head: 'node-head',
	commit: '',
	merge: 'node-merge',
	initial: 'node-root',
};

const decoration: Partial<Record<TimelineKind, string>> = {
	next: t('commit.upcoming'),
	upcoming: t('commit.upcoming'),
	head: '(HEAD -> main)',
	initial: '(initial commit)',
};

const hash = entry.kind === 'next' || entry.kind === 'upcoming' ? undefined : shortHash(entry.id);
const deco = entry.branch ? `Merge ${entry.branch.name}` : decoration[entry.kind];
const upcoming = entry.kind === 'next' || entry.kind === 'upcoming' || entry.kind === 'head';
const external = entry.href ? /^https?:/.test(entry.href) : false;
const metaEntries = entry.meta ? Object.entries(entry.meta) : [];
const showPhoto = !compact && entry.image && entry.featured;
const showThumb = !compact && entry.image && !entry.featured;
const isNext = !compact && entry === nextEvent;
// The registration lives in its ticket (Registrations.astro); the card only points to it. A free activity has no ticket to point to.
const mode = entry.kind === 'upcoming' ? ticketMode(entry) : undefined;
const ticketLink = !compact && mode !== undefined && mode !== 'free' ? `#${ticketAnchor(entry.id)}` : undefined;
const hasRegistration = !compact && Boolean(ticketLink || entry.calendarHref);
// The hash line is decoration (aria-hidden, derived from the id): a dense card leaves it out.
const showRef = !dense && Boolean(hash || deco);
---

<li
	class:list={['commit', { 'is-last': last }]}
	data-type={entry.type}
	id={!compact && entry.kind === 'upcoming' ? eventAnchor(entry.id) : undefined}
>
	<span
		class:list={['node', nodeClass[entry.kind]]}
		data-node
		data-root-node={entry.kind === 'initial' ? '' : undefined}
		aria-hidden="true"
	></span>
	<span class="link" data-link aria-hidden="true"></span>
	<div
		class:list={['card', 'card-row', { 'has-reg': hasRegistration, 'card-dense': dense }]}
		data-card={compact ? undefined : ''}
	>
		{isNext && (
			<span class="sticker" style="top:-0.75rem;right:1.25rem" aria-hidden="true">
				{t('commit.new')}
			</span>
		)}
		<div class="card-main">
			{entry.stamp && (
				<p class="stamp-line leading-none">
					<span class:list={['stamp', { 'stamp-past': !upcoming }]}>{entry.stamp}</span>
					{entry.demo && (
						<span class="demo-tag" title={t('demo.title')}>
							demo
						</span>
					)}
				</p>
			)}
			<h3 class:list={['font-display text-lead leading-snug text-ink', { 'mt-3': !dense }]}>{entry.title}</h3>
			{entry.msg && <p class="msg">{entry.msg}</p>}
			{!compact && entry.description && (
				<p class:list={['max-w-[60ch] text-mist', dense ? 'text-secondary' : 'mt-2']}>{entry.description}</p>
			)}
			{!compact && entry.href && (
				<a
					href={entry.href}
					class:list={[
						'inline-block text-label font-semibold text-sky underline decoration-2 underline-offset-4 hover:text-ink',
						{ 'mt-3': !dense },
					]}
					target={external ? '_blank' : undefined}
					rel={external ? 'me noopener' : undefined}
				>
					{entry.hrefLabel}
					{external && <span class="sr-only"> {t('newTab')}</span>}
				</a>
			)}
			{showRef && (
				<p class="ref" aria-hidden="true">
					{hash}
					{deco && <span class:list={['ref-deco', { 'ml-2': hash }]}>{deco}</span>}
				</p>
			)}
		</div>
		{!compact && metaEntries.length > 0 && (
			<dl class="card-meta">
				{metaEntries.map(([label, value]) => (
					<div>
						<dt>{metaLabel(locale, label)}</dt>
						<dd>{value}</dd>
					</div>
				))}
			</dl>
		)}
		{hasRegistration && (
			<div class="reg">
				{ticketLink && (
					<a class="reg-ticket" href={ticketLink}>
						{t('ticket.link')}
						<span aria-hidden="true"> →</span>
					</a>
				)}
				{entry.calendarHref && (
					<a class="reg-calendar" href={entry.calendarHref}>
						{t('calendar.add')}
						<span aria-hidden="true"> · .ics</span>
					</a>
				)}
			</div>
		)}
		{showPhoto && entry.image && (
			<div class="duo photo">
				<Photo
					photo={entry.image}
					box={{ width: 720, height: 360 }}
					widths={[480, 720, 960]}
					sizes="(min-width: 1024px) 28rem, 90vw"
					loading="lazy"
				/>
			</div>
		)}
		{showThumb && entry.image && (
			<div class="duo thumb">
				<Photo photo={entry.image} box={{ width: 224, height: 224 }} widths={[112, 224]} sizes="7rem" loading="lazy" />
			</div>
		)}
	</div>
	<slot />
</li>
