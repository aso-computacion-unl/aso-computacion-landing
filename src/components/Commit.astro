---
import { Image } from 'astro:assets';
import { type TimelineKind, timeline } from '../data/site';
import { shortHash } from './shortHash';

type Entry = (typeof timeline)[number];

interface Props {
	entry: Entry;
	last?: boolean;
	compact?: boolean;
}

const { entry, last = false, compact = false } = Astro.props;

const nodeClass: Record<TimelineKind, string> = {
	next: 'node-next',
	upcoming: 'node-upcoming',
	head: 'node-head',
	commit: '',
	merge: 'node-merge',
	initial: '',
};

const decoration: Partial<Record<TimelineKind, string>> = {
	next: '(por venir)',
	upcoming: '(por venir)',
	head: '(HEAD -> main)',
	initial: '(initial commit)',
};

const hash = entry.kind === 'next' || entry.kind === 'upcoming' ? undefined : shortHash(entry.id);
const deco = entry.branch ? `Merge ${entry.branch.name}` : decoration[entry.kind];
const external = entry.href ? /^https?:/.test(entry.href) : false;
---

<li class:list={['commit', { 'is-last': last }]}>
	<span class:list={['node', nodeClass[entry.kind]]} data-node aria-hidden="true"></span>
	<span class="link" data-link aria-hidden="true"></span>
	<div class="card">
		{
			entry.stamp && (
				<p class="leading-none">
					<span class="stamp">{entry.stamp}</span>
					{entry.demo && <span class="demo-tag" title="Contenido de ejemplo">demo</span>}
				</p>
			)
		}
		<h3 class="mt-3 font-display text-lg leading-snug text-white md:text-xl">{entry.title}</h3>
		{!compact && entry.description && <p class="mt-2 max-w-[60ch] text-mist">{entry.description}</p>}
		{
			!compact && entry.meta && (
				<dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[0.8125rem] leading-5">
					{Object.entries(entry.meta).map(([label, value]) => (
						<div class="flex gap-1.5">
							<dt class="text-mist">{label}</dt>
							<dd class="text-white">{value}</dd>
						</div>
					))}
				</dl>
			)
		}
		{
			!compact && entry.href && (
				<a
					href={entry.href}
					class="mt-3 inline-block text-sm font-semibold text-sky underline decoration-2 underline-offset-4 hover:text-white"
					target={external ? '_blank' : undefined}
					rel={external ? 'me noopener' : undefined}
				>
					{entry.hrefLabel}
					{external && <span class="sr-only"> (se abre en otra pestaña)</span>}
				</a>
			)
		}
		{
			(hash || deco) && (
				<p class="ref" aria-hidden="true">
					{hash}
					{deco && <span class:list={['ref-deco', { 'ml-2': hash }]}>{deco}</span>}
				</p>
			)
		}
		{
			!compact && entry.image && (
				<div class="photo">
					<Image
						src={entry.image}
						alt={entry.imageAlt ?? ''}
						width={720}
						height={360}
						widths={[480, 720, 960]}
						sizes="(min-width: 1024px) 40rem, 90vw"
						loading="lazy"
					/>
				</div>
			)
		}
	</div>
	<slot />
</li>
