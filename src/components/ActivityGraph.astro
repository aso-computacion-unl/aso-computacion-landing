---
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { typeLabel, useTranslations } from '../i18n/ui';
import { activityTypes } from '../data/site';
import Commit from './Commit.astro';
import HistoryEntries from './HistoryEntries.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { nextEvent, timeline } = getContent(locale);
const headIndex = timeline.findIndex((entry) => entry.kind === 'head');
const planned = timeline.slice(0, headIndex);
const history = timeline.slice(headIndex);
// Compact history: HEAD and the latest past entries show; the older ones fold into a disclosure (a plain <details>, so it
// opens without JS) and the root commit always shows, because the rail ends on it.
const RECENT_PAST = 2;
const recent = history.slice(0, 1 + RECENT_PAST);
const older = history.length > RECENT_PAST + 2 ? history.slice(1 + RECENT_PAST, -1) : [];
const shown = older.length > 0 ? recent : history.slice(0, -1);
const root = history.slice(-1);
const typedCount = (type: string) => timeline.filter((entry) => entry.type === type).length;
---

<section id="actividades" class="deep bg-navy-deep pb-16 pt-20 sm:pb-20 sm:pt-24 lg:pb-20 lg:pt-24">
	<div class="wrap grid gap-10 lg:grid-cols-[minmax(20rem,26rem)_minmax(0,1fr)] lg:gap-16">
		<aside
			class="lg:sticky lg:top-24 lg:max-h-[calc(100svh-7rem)] lg:self-start lg:overflow-y-auto"
			aria-label={t('activities.aside')}
		>
			<p class="max-w-[34ch] text-body text-mist">{t('activities.intro')}</p>
			<p class="mt-2 font-mono text-label text-sky" aria-hidden="true">
				$ git log --graph main
			</p>

			{nextEvent && (
				<div class="panel mt-8 p-4 sm:p-6" data-countdown={nextEvent.date}>
					<p class="leading-none">
						<span class="stamp" style="margin-left:0">
							{t('activities.next')}
						</span>
						{nextEvent.demo && (
							<span class="demo-tag" title={t('demo.title')}>
								demo
							</span>
						)}
					</p>
					<div data-static>
						<p class="mt-5 font-mono text-label text-mist">{t('activities.date')}</p>
						<p class="font-display text-title leading-none text-ink">{nextEvent.stamp}</p>
					</div>
					<div data-live hidden>
						<p class="mt-4 font-mono text-label text-mist sm:mt-5" data-count-label>
							{t('count.many')}
						</p>
						<p class="flex items-baseline gap-3 leading-none">
							<span
								class="inline-flex overflow-hidden font-display text-display leading-[0.95] text-ink"
								data-count-num
							>
								00
							</span>
							<span class="font-display text-lead text-sky" data-count-unit>
								{t('count.dayMany')}
							</span>
						</p>
					</div>
					<p class="mt-4 text-body font-semibold leading-snug text-ink">{nextEvent.title}</p>
					<p class="mt-1 font-mono text-label leading-5 text-mist">
						{nextEvent.stamp}
						{nextEvent.meta?.hora && ` · ${nextEvent.meta.hora}`}
						{nextEvent.meta?.lugar && ` · ${nextEvent.meta.lugar}`}
					</p>
				</div>
			)}

			<div class="js-only mt-8" data-filters>
				<p class="font-mono text-label text-sky" aria-hidden="true">
					git log --grep=
				</p>
				<div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={t('filters.label')}>
					<button type="button" class="chip" data-filter="all" aria-pressed="true">
						{t('filters.all')}
					</button>
					{activityTypes.map((type) => (
						<button type="button" class="chip" data-filter={type} aria-pressed="false">
							{typeLabel(locale, type)}
							<span class="chip-count">{typedCount(type)}</span>
						</button>
					))}
				</div>
				<p class="mt-3 min-h-5 font-mono text-label text-mist" data-filter-status aria-live="polite"></p>
			</div>

			<ul
				class="legend mt-8 hidden space-y-3 font-mono text-label leading-5 text-mist lg:block"
				aria-label={t('legend.label')}
			>
				<li class="flex items-center gap-3">
					<span class="swatch bg-signal" aria-hidden="true"></span>
					{t('legend.next')}
				</li>
				<li class="flex items-center gap-3">
					<span class="swatch swatch-dash" aria-hidden="true"></span>
					{t('legend.planned')}
				</li>
				<li class="flex items-center gap-3">
					<span class="swatch" aria-hidden="true"></span>
					{t('legend.past')}
				</li>
				<li class="flex items-center gap-3">
					<span class="swatch bg-ink" aria-hidden="true"></span>
					{t('legend.branch')}
				</li>
				<li class="flex items-center gap-3">
					<span class="swatch size-4" aria-hidden="true"></span>
					{t('legend.head')}
				</li>
			</ul>
		</aside>

		<div class="lane-vars contents lg:block">
			<div class="trunk-head order-first">
				<span class="trunk" data-trunk data-rail-trunk aria-hidden="true"></span>
				<h2 class="h2-xl">{t('activities.title')}</h2>
			</div>
			<div data-timeline>
				<p class="tag tag-plan lane-tag mb-1">{t('soon')}</p>
				<div class="graph plan">
					<span class="rail rail-main" data-rail data-rail-scrub></span>
					<span class="rail-cursor" data-rail-cursor aria-hidden="true"></span>
					<ol>
						{planned.map((entry) => (
							<Commit entry={entry} dense />
						))}
					</ol>
				</div>
				<div class="graph" data-history>
					<span class="rail rail-main" data-rail data-rail-scrub></span>
					<span class="rail-cursor" data-rail-cursor aria-hidden="true"></span>
					<HistoryEntries entries={shown} />
					{older.length > 0 && (
						<details class="history-more" data-history-more>
							<summary class="history-toggle">
								<span class="history-show">{t('activities.history.show', { count: older.length })}</span>
								<span class="history-hide">{t('activities.history.hide')}</span>
							</summary>
							<HistoryEntries entries={older} />
						</details>
					)}
					<HistoryEntries entries={root} last />
				</div>
			</div>
		</div>
	</div>
</section>
