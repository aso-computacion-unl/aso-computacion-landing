---
// The Actividades section. It opens with the scroll moment that used to open the page: the isotype grows, its brackets
// slide off and its cursor thins into the stem, which lands on the trunk below (src/scripts/motion.ts). The isotype stays
// on top of the stem as the root commit. The trunk then splits into two sides: what is coming on a dotted lane, what we
// already did on a solid one (stacked on phones). Without motion the opener is its static end state.
import IsotypeColor from '../assets/brand/isotype-color.svg';
import IsotypeWhite from '../assets/brand/isotype-white.svg';
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { typeLabel, useTranslations } from '../i18n/ui';
import { activityTypes } from '../data/site';
import Commit from './Commit.astro';
import HeroMark from './HeroMark.astro';
import HistoryEntries from './HistoryEntries.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { site, timeline } = getContent(locale);
const headIndex = timeline.findIndex((entry) => entry.kind === 'head');
const planned = timeline.slice(0, headIndex);
const history = timeline.slice(headIndex);
// Compact history: HEAD and the latest past entries show; the older ones fold into a disclosure (a plain <details>, so it
// opens without JS) and the root commit always shows, because the rail ends on it.
const RECENT_PAST = 1;
const recent = history.slice(0, 1 + RECENT_PAST);
const older = history.length > RECENT_PAST + 2 ? history.slice(1 + RECENT_PAST, -1) : [];
const shown = older.length > 0 ? recent : history.slice(0, -1);
const root = history.slice(-1);
const typedCount = (type: string) => timeline.filter((entry) => entry.type === type).length;
---

<section id="actividades" class="act lane-vars bg-navy" aria-labelledby="actividades-title">
	<div class="op" data-opener>
		<div class="op-stage" data-opener-stage>
			<div class="op-head wrap" data-opener-head>
				<h2 class="h2-xl" id="actividades-title">
					{t('activities.title')}
				</h2>
				<p class="lead">{t('activities.intro')}</p>
			</div>
			<div class="op-mark" data-opener-mark aria-hidden="true">
				<HeroMark />
			</div>
			<div class="op-end">
				<span class="op-stem" data-opener-stem aria-hidden="true"></span>
				<span class="op-emblem" data-opener-emblem aria-hidden="true">
					<IsotypeWhite class="theme-dark-only" />
					<IsotypeColor class="theme-light-only" />
				</span>
				<div class="op-cue" data-opener-cue aria-hidden="true">
					<p class="font-mono text-label text-sky">$ git log --graph main</p>
					<p class="op-cue-title">{site.heroCue}</p>
				</div>
			</div>
		</div>
	</div>

	<div class="sp pb-section">
		<div class="wrap">
			<div class="sp-top">
				<span class="trunk" data-trunk aria-hidden="true"></span>
				<div class="sp-controls">
					<div class="js-only sp-filters" data-filters>
						<p class="font-mono text-label text-sky" aria-hidden="true">
							git log --grep=
						</p>
						<div class="mt-3 flex flex-wrap justify-center gap-2" role="group" aria-label={t('filters.label')}>
							<button type="button" class="chip" data-filter="all" aria-pressed="true">
								{t('filters.all')}
							</button>
							{activityTypes.map((type) => (
								<button type="button" class="chip" data-filter={type} aria-pressed="false">
									{typeLabel(locale, type)}
									<span class="chip-count">{typedCount(type)}</span>
								</button>
							))}
						</div>
						<p class="mt-2 min-h-5 font-mono text-label text-mist" data-filter-status aria-live="polite"></p>
					</div>
					<ul class="legend sp-legend" aria-label={t('legend.label')}>
						<li>
							<span class="swatch bg-signal" aria-hidden="true"></span>
							{t('legend.next')}
						</li>
						<li>
							<span class="swatch swatch-dash" aria-hidden="true"></span>
							{t('legend.planned')}
						</li>
						<li>
							<span class="swatch" aria-hidden="true"></span>
							{t('legend.past')}
						</li>
						<li>
							<span class="swatch bg-ink" aria-hidden="true"></span>
							{t('legend.branch')}
						</li>
						<li>
							<span class="swatch size-4" aria-hidden="true"></span>
							{t('legend.head')}
						</li>
					</ul>
				</div>
			</div>

			<div class="sp-cols" data-timeline>
				<span class="sp-bus" data-fork aria-hidden="true"></span>
				<div class="sp-col sp-plan">
					<span class="sp-pre" data-fork aria-hidden="true"></span>
					<p class="tag tag-plan sp-label">{t('soon')}</p>
					<div class="graph plan">
						<span class="rail rail-main" data-rail data-rail-scrub></span>
						<span class="rail-cursor" data-rail-cursor aria-hidden="true"></span>
						<ol>
							{planned.map((entry) => (
								<Commit entry={entry} dense />
							))}
						</ol>
					</div>
				</div>
				<div class="sp-col">
					<span class="sp-pre" data-fork aria-hidden="true"></span>
					<p class="tag sp-label">{t('activities.past')}</p>
					<div class="graph" data-history>
						<span class="rail rail-main" data-rail data-rail-scrub></span>
						<span class="rail-cursor" data-rail-cursor aria-hidden="true"></span>
						<HistoryEntries entries={shown} />
						{older.length > 0 && (
							<details class="history-more" data-history-more>
								<summary class="history-toggle">
									<span class="history-show">{t('activities.history.show', { count: older.length })}</span>
									<span class="history-hide">{t('activities.history.hide')}</span>
								</summary>
								<HistoryEntries entries={older} />
							</details>
						)}
						<HistoryEntries entries={root} last />
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
