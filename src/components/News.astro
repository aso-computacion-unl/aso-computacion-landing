---
// Home section: a teaser for the news. The three latest posts as a plain list (date, title, arrow; each row links to its
// post) and one button to the news page, which has the rest. The title decrypts once (src/scripts/moments.ts). Hidden
// by the page when there is nothing to show.
import { getContent } from '../data/content';
import { localizedPath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { latestNews } = getContent(locale);
---

<section id="novedades" class="deep bg-navy-deep py-section">
	<div class="wrap">
		<SectionHead eyebrow={t('news.eyebrow')} title={t('news.title')} lead={t('news.lead')} decrypt>
			<div slot="aside" class="flex lg:justify-end">
				<Button href={localizedPath('/novedades', locale)}>{t('news.seeAll')}</Button>
			</div>
		</SectionHead>

		<ul class="news-list mt-head">
			{latestNews.map((item) => (
				<li>
					<a class="news-link" href={item.href}>
						<time datetime={item.date}>{item.stamp}</time>
						<span class="news-title">{item.title}</span>
						<span class="news-arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.news-list {
		list-style: none;
		border-top: 1px solid color-mix(in oklab, var(--color-sky) 24%, transparent);
	}

	.news-list li {
		border-bottom: 1px solid color-mix(in oklab, var(--color-sky) 24%, transparent);
	}

	.news-link {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1.25rem 0;
		color: var(--color-ink);
		text-decoration: none;
	}

	.news-link time {
		font-family: var(--font-mono);
		font-size: var(--text-label);
		color: var(--color-mist);
	}

	.news-title {
		font-size: var(--text-lead);
		font-stretch: 112%;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01em;
		overflow-wrap: anywhere;
	}

	.news-arrow {
		color: var(--color-mist);
		transition: color 0.15s;
	}

	.news-link:hover .news-title,
	.news-link:focus-visible .news-title {
		text-decoration: underline;
		text-decoration-color: var(--color-sky);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.22em;
	}

	.news-link:hover .news-arrow,
	.news-link:focus-visible .news-arrow {
		color: var(--color-sky);
	}

	.news-link:focus-visible {
		outline: 2px solid var(--color-sky);
		outline-offset: 2px;
	}

	/* On a phone the date sits above the title instead of beside it. */
	@media (max-width: 39.9375rem) {
		.news-link {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.25rem 1rem;
		}

		.news-link time {
			grid-column: 1 / -1;
		}
	}
</style>
