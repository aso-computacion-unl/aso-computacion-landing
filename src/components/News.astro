---
// Home section: a teaser for the news laid out as a front page (S6). The three latest posts, each one link to its post:
// the newest is a full-width banner (big day, month and year, a "Nuevo" badge, title, round arrow) and the rest are
// cards, two to a row, with the same big day. One button goes to the news page, which has the rest. The title decrypts
// once (src/scripts/moments.ts). Hidden by the page when there is nothing to show. The look is in src/styles/sections.css.
import { getContent } from '../data/content';
import { localizedPath, toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import Button from './Button.astro';
import SectionHead from './SectionHead.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { latestNews } = getContent(locale);

// "14 abr 2026" → the day is the big numeral and the rest its caption (a month-only date has the month in its place).
const split = (stamp: string) => {
	const [big, ...rest] = stamp.trim().split(/\s+/);
	return { big, rest: rest.join(' ') };
};
const posts = latestNews.map((item) => ({ item, when: split(item.stamp) }));
---

<section id="novedades" class="deep bg-navy-deep py-section">
	<div class="wrap">
		<SectionHead eyebrow={t('news.eyebrow')} title={t('news.title')} lead={t('news.lead')} decrypt>
			<div slot="aside" class="flex lg:justify-end">
				<Button href={localizedPath('/novedades', locale)}>{t('news.seeAll')}</Button>
			</div>
		</SectionHead>

		<ul class="news-list mt-head">
			{posts.map(({ item, when }, index) => (
				<li>
					<a class="news-link" href={item.href}>
						<span class="news-head">
							<time class="news-when" datetime={item.date}>
								<b>{when.big}</b>
								<span>{when.rest}</span>
							</time>
							{index === 0 && <span class="news-new">{t('news.new')}</span>}
						</span>
						<span class="news-title">{item.title}</span>
						<span class="news-arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
