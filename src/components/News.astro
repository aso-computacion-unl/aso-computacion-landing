---
// Home section: the latest news as the newest tags of the repo. Hidden by the page when there is nothing to show.
import { latestNews, news } from '../data/content';
import Button from './Button.astro';
import NewsCard from './NewsCard.astro';
import SectionHead from './SectionHead.astro';

const count = latestNews.length;
---

<section id="novedades" class="deep bg-navy-deep py-16 sm:py-24 lg:py-32">
	<div class="wrap">
		<SectionHead
			eyebrow="$ git tag --sort=-creatordate"
			title="Novedades"
			lead="Lo último que anunciamos: avisos, resultados y noticias para quienes estudian Computación."
		>
			<div slot="aside" class="flex lg:justify-end">
				<Button href="/novedades" variant="ghost">{news.length > count ? `Ver las ${news.length} novedades` : 'Ver todas las novedades'}</Button>
			</div>
		</SectionHead>

		<ul class="news-grid mt-12 lg:mt-16" data-count={count}>
			{
				latestNews.map((item, index) => (
					<li class="news-item" data-tile>
						<NewsCard item={item} variant={count === 3 && index > 0 ? 'row' : 'feature'} wide={count === 1} as="h3" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.news-grid {
		display: grid;
		gap: 1rem;
		list-style: none;
	}

	.news-item {
		min-width: 0;
	}

	@media (min-width: 48rem) {
		.news-grid[data-count='2'] {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Three: the newest is the big one, the other two stack beside it. */
	@media (min-width: 64rem) {
		.news-grid[data-count='3'] {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.news-grid[data-count='3'] .news-item:first-child {
			grid-column: 1 / span 7;
			grid-row: 1 / span 2;
			--cover-ratio: 2 / 1;
		}

		.news-grid[data-count='3'] .news-item:not(:first-child) {
			grid-column: 8 / span 5;
		}
	}
</style>
