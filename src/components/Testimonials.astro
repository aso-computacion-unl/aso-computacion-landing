---
import type { Testimonial } from '../lib/admin-content/model';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import Photo from './Photo.astro';
import SectionHead from './SectionHead.astro';

interface Props {
	testimonials: Testimonial[];
}

const { testimonials } = Astro.props;
const t = useTranslations(toLocale(Astro.currentLocale));
---

{testimonials.length > 0 && (
	<section id="testimonios" class="bg-navy py-16 sm:py-24 lg:py-32">
		<div class="wrap">
			<SectionHead eyebrow="$ git log --grep=thanks" title={t('testimonials.title')} lead={t('testimonials.lead')} />

			<ul class="quotes mt-12 lg:mt-16" aria-label={t('testimonials.list')}>
				{testimonials.map((item) => (
					<li class="quote">
						<figure class="quote-figure">
							<blockquote class="quote-text">
								<p>{item.quote}</p>
							</blockquote>
							<figcaption class="quote-by">
								{item.photo && (
									<Photo
										photo={item.photo}
										box={{ width: 56, height: 56 }}
										widths={[56, 112, 168]}
										sizes="3.5rem"
										fit="cover"
										class="quote-photo"
									/>
								)}
								<span>
									<span class="quote-name">{item.name}</span>
									<span class="quote-role">{item.role}</span>
								</span>
							</figcaption>
						</figure>
					</li>
				))}
			</ul>
		</div>
	</section>
)}
