---
import Photo from './Photo.astro';
import { isRemote } from '../lib/admin-content/map';
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import SectionHead from './SectionHead.astro';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { team } = getContent(locale);

// Grid math (7 people, no holes): phones 2 cols (6 small cards in pairs, last one wide), tablets 6 cols
// (2 wide, 3 small, 2 half), desktop 10 cols (2 wide of 5, then 5 small of 2).
// On phones a card is a column (photo, then the name plate underneath), so its height comes from the photo and no
// aspect class applies below md; from md up the card keeps its own aspect and the plate overlays the photo.
const layout = [
	'member-lg md:col-span-3 md:aspect-square lg:col-span-5',
	'member-lg md:col-span-3 md:aspect-square lg:col-span-5',
	'md:aspect-[3/4] md:col-span-2 lg:col-span-2',
	'md:aspect-[3/4] md:col-span-2 lg:col-span-2',
	'md:aspect-[3/4] md:col-span-2 lg:col-span-2',
	'md:col-span-3 md:aspect-square lg:col-span-2 lg:aspect-[3/4]',
	'member-wide col-span-2 md:col-span-3 md:aspect-square lg:col-span-2 lg:aspect-[3/4] [&_img]:object-[50%_25%] md:[&_img]:object-[50%_30%] lg:[&_img]:object-top',
];

// Boards of any other size still get a sensible card: extra members use the small portrait.
const extraLayout = 'md:aspect-[3/4] md:col-span-2 lg:col-span-2';

// Handle shown in the "git show" panel: first name only, no accents. Not a real social handle.
const handle = (name: string) =>
	name
		.split(' ')[0]
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase();
---

<section id="directiva" class="bg-navy py-16 sm:py-24 lg:py-32">
	<div class="wrap">
		<SectionHead eyebrow="$ git shortlog" title={t('board.title')} lead={t('board.lead')}>
			<div slot="aside" class="count">
				<p class="count-num" aria-hidden="true">
					{team.length}
				</p>
				<div>
					<p class="count-label">{t('board.count')}</p>
					<ul class="mt-4 flex flex-wrap gap-2" aria-label={t('board.roles')}>
						{team.map((member) => (
							<li class="role-chip">{member.role}</li>
						))}
					</ul>
				</div>
			</div>
		</SectionHead>

		<ul class="mt-12 grid grid-cols-2 gap-2.5 md:grid-cols-6 md:gap-4 lg:mt-16 lg:grid-cols-10 lg:gap-5">
			{team.map((member, index) => (
				<li class:list={['member', layout[index] ?? extraLayout]} tabindex="0" data-member>
					<div class="duo portrait">
						<Photo
							photo={member.photo}
							box={{ width: index < 2 ? 960 : 480, height: index < 2 ? 720 : 640 }}
							widths={isRemote(member.photo) ? [480, 960] : undefined}
							sizes={
								isRemote(member.photo)
									? index < 2
										? '(min-width: 1024px) 28rem, 50vw'
										: '(min-width: 1024px) 14rem, 50vw'
									: undefined
							}
							fit="cover"
							position="top"
							loading="lazy"
							class="object-top"
						/>
					</div>
					<p class="hint" aria-hidden="true">
						{t('board.hint')}
					</p>
					{index < 2 && (
						<div class="rest-hint" aria-hidden="true">
							<span>git show @{handle(member.name)}</span>
							<span>{t('board.more')}</span>
							{member.fun && (
								<dl class="rest-fun">
									<div>
										<dt>{t('board.language')}</dt>
										<dd>{member.fun.language}</dd>
									</div>
									<div>
										<dt>commit message</dt>
										<dd>"{member.fun.motto}"</dd>
									</div>
									<div>
										<span class="demo-tag" style="margin-left:0">
											demo
										</span>
									</div>
								</dl>
							)}
						</div>
					)}
					<div class="plate" aria-hidden="true">
						<p>{member.name}</p>
						<p>{member.role}</p>
					</div>
					<div class="show">
						<p class="show-cmd" aria-hidden="true">
							git show @{handle(member.name)}
						</p>
						<div class="show-body">
							<p class="show-role">{member.role}</p>
							<p class="show-name">{member.name}</p>
							{member.fun && (
								<dl class="show-fun">
									<div>
										<dt>{t('board.language')}</dt>
										<dd>{member.fun.language}</dd>
									</div>
									<div>
										<dt>commit message</dt>
										<dd>"{member.fun.motto}"</dd>
									</div>
									<div>
										<span class="demo-tag" style="margin-left:0" title={t('demo.detail')}>
											demo
										</span>
									</div>
								</dl>
							)}
						</div>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>
