---
import { Image } from 'astro:assets';
import { team } from '../data/site';
import SectionHead from './SectionHead.astro';

// Grid math (7 people, no holes): phones 2 cols (6 small cards in pairs, last one wide), tablets 6 cols
// (2 wide, 3 small, 2 half), desktop 10 cols (2 wide of 5, then 5 small of 2).
const layout = [
	'member-lg md:col-span-3 md:aspect-square lg:col-span-5',
	'member-lg md:col-span-3 md:aspect-square lg:col-span-5',
	'aspect-[3/4] md:col-span-2 lg:col-span-2',
	'aspect-[3/4] md:col-span-2 lg:col-span-2',
	'aspect-[3/4] md:col-span-2 lg:col-span-2',
	'aspect-[3/4] md:col-span-3 md:aspect-square lg:col-span-2 lg:aspect-[3/4]',
	'col-span-2 aspect-[2/1] md:col-span-3 md:aspect-square lg:col-span-2 lg:aspect-[3/4] [&_img]:object-[50%_30%] lg:[&_img]:object-top',
];

// Handle shown in the "git show" panel: first name only, no accents. Not a real social handle.
const handle = (name: string) =>
	name
		.split(' ')[0]
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase();
---

<section id="directiva" class="bg-navy py-16 sm:py-24 lg:py-32">
	<div class="wrap">
		<SectionHead
			eyebrow="$ git shortlog"
			title="Directiva"
			lead="Las personas que hoy representan a los estudiantes de Computación. Pasa el cursor o toca una tarjeta para conocerlas."
		>
			<div slot="aside" class="count">
				<p class="count-num" aria-hidden="true">{team.length}</p>
				<div>
					<p class="count-label">personas que te representan</p>
					<ul class="mt-4 flex flex-wrap gap-2" aria-label="Cargos">
						{team.map((member) => <li class="role-chip">{member.role}</li>)}
					</ul>
				</div>
			</div>
		</SectionHead>

		<ul class="mt-12 grid grid-cols-2 gap-2.5 md:grid-cols-6 md:gap-4 lg:mt-16 lg:grid-cols-10 lg:gap-5">
			{
				team.map((member, index) => (
					<li class:list={['member', layout[index]]} tabindex="0" data-member>
						<div class="duo portrait">
							<Image
								src={member.photo}
								alt={`Foto de ${member.name}`}
								width={index < 2 ? 960 : 480}
								height={index < 2 ? 720 : 640}
								fit="cover"
								position="top"
								loading="lazy"
								class="object-top"
							/>
						</div>
						<p class="hint" aria-hidden="true">¿quién es?</p>
						{index < 2 && (
							<div class="rest-hint" aria-hidden="true">
								<span>git show @{handle(member.name)}</span>
								<span>pasa el cursor o toca para ver más</span>
								<dl class="rest-fun">
									<div>
										<dt>lenguaje favorito</dt>
										<dd>{member.fun.language}</dd>
									</div>
									<div>
										<dt>commit message</dt>
										<dd>"{member.fun.motto}"</dd>
									</div>
									<div>
										<span class="demo-tag" style="margin-left:0">demo</span>
									</div>
								</dl>
							</div>
						)}
						<div class="plate" aria-hidden="true">
							<p>{member.name}</p>
							<p>{member.role}</p>
						</div>
						<div class="show">
							<p class="show-cmd" aria-hidden="true">git show @{handle(member.name)}</p>
							<div class="show-body">
								<p class="show-role">{member.role}</p>
								<p class="show-name">{member.name}</p>
								<dl class="show-fun">
									<div>
										<dt>lenguaje favorito</dt>
										<dd>{member.fun.language}</dd>
									</div>
									<div>
										<dt>commit message</dt>
										<dd>"{member.fun.motto}"</dd>
									</div>
									<div>
										<span class="demo-tag" style="margin-left:0" title="Dato de ejemplo">demo</span>
									</div>
								</dl>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
