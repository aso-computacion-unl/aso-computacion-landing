---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Isotype from '../assets/brand/isotype-white.svg';
import Logo from '../assets/brand/logo-white-sky.svg';
import { activities, navLinks, site, socials, team } from '../data/site';
---

<Layout title={site.name} description={site.description}>
	<header class="sticky top-0 z-10 border-b border-white/10 bg-navy/85 backdrop-blur">
		<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
			<a href="#" class="flex items-center gap-3 font-display text-lg text-white">
				<Isotype class="h-8 w-auto" aria-hidden="true" />
				{site.name}
			</a>
			<ul class="hidden gap-6 text-sm text-mist sm:flex">
				{navLinks.map((link) => (
					<li><a href={link.href} class="hover:text-sky">{link.label}</a></li>
				))}
			</ul>
		</nav>
	</header>

	<main>
		<section class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
			<Logo class="h-40 w-auto sm:h-56" role="img" aria-label={site.name} />
			<p class="mt-10 font-mono text-sm text-sky">&gt; hola_mundo</p>
			<h1 class="mt-4 font-display text-4xl sm:text-6xl">{site.name}</h1>
			<p class="mt-6 max-w-2xl text-lg text-mist">{site.tagline}. {site.description}</p>
			<a
				href="#contacto"
				class="mt-10 inline-block rounded-md bg-sky px-6 py-3 font-semibold text-navy hover:bg-white"
			>
				Únete
			</a>
		</section>

		<section id="nosotros" class="border-t border-white/10">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="font-display text-3xl">Nosotros</h2>
				<p class="mt-4 max-w-3xl text-mist">
					Somos la asociación estudiantil de la carrera de Computación. Nuestra misión es
					acompañar a cada estudiante durante su formación y fortalecer la comunidad.
				</p>
			</div>
		</section>

		<section id="actividades" class="border-t border-white/10">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="font-display text-3xl">Actividades</h2>
				<div class="mt-10 grid gap-6 md:grid-cols-3">
					{activities.map((item) => (
						<article class="rounded-lg border border-white/10 bg-white/5 p-6">
							<h3 class="text-xl font-semibold text-sky">{item.title}</h3>
							<p class="mt-3 text-mist">{item.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="directiva" class="bg-mist text-navy">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="font-display text-3xl">Directiva</h2>
				<ul class="mt-10 grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
					{team.map((member) => (
						<li class="overflow-hidden rounded-lg bg-white">
							<Image
								src={member.photo}
								alt={member.name}
								width={480}
								height={600}
								fit="cover"
								class="aspect-[4/5] w-full object-cover object-top"
							/>
							<div class="p-4">
								<p class="font-semibold">{member.name}</p>
								{member.role && <p class="mt-1 text-sm text-navy/70">{member.role}</p>}
							</div>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section id="contacto">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="font-display text-3xl">Contacto</h2>
				<p class="mt-4 text-mist">
					Síguenos en nuestras redes o escríbenos por mensaje directo.
				</p>
				<ul class="mt-6 flex flex-wrap gap-6">
					{socials.map((social) => (
						<li>
							<a href={social.href} rel="me noopener" target="_blank" class="text-mist hover:text-sky">
								{social.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	</main>

	<footer class="border-t border-white/10 py-8 text-center text-sm text-mist/70">
		© {new Date().getFullYear()} {site.name}
	</footer>
</Layout>
