---
import About from '../components/About.astro';
import ActivityGraph from '../components/ActivityGraph.astro';
import Board from '../components/Board.astro';
import FirstCommit from '../components/FirstCommit.astro';
import Hero from '../components/Hero.astro';
import Remotes from '../components/Remotes.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`${site.name} · ${site.tagline}`} description={site.description}>
	<SiteHeader />
	<main id="contenido">
		<Hero />
		<ActivityGraph />
		<About />
		<Board />
		<FirstCommit />
		<Remotes />
	</main>
	<SiteFooter />
</Layout>
