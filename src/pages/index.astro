---
import About from '../components/About.astro';
import ActivityGraph from '../components/ActivityGraph.astro';
import Board from '../components/Board.astro';
import Hero from '../components/Hero.astro';
import Join from '../components/Join.astro';
import Faq from '../components/Faq.astro';
import Socials from '../components/Socials.astro';
import Ribbon from '../components/Ribbon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`${site.name} · ${site.tagline}`} description={site.description}>
	<SiteHeader />
	<main id="contenido">
		<Hero />
		<Ribbon />
		<ActivityGraph />
		<About />
		<Board />
		<Join />
		<Faq />
		<Socials />
	</main>
	<SiteFooter />
</Layout>
