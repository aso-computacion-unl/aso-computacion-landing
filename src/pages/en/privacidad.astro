---
import NewsProse from '../../components/NewsProse.astro';
import SectionHead from '../../components/SectionHead.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getContent } from '../../data/content';
import { contactEmail } from '../../data/site';
import { privacy } from '../../i18n/privacy';
import Layout from '../../layouts/Layout.astro';

// The policy lives in src/i18n/privacy.ts; the Spanish page is /privacidad.
const copy = privacy.en;
const { site } = getContent('en');
---

<Layout title={`${copy.title} · ${site.name}`} description={copy.description}>
	<SiteHeader />
	<main id="contenido" class="bg-navy py-section">
		<div class="wrap">
			<SectionHead level={1} eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />
			<div class="mt-12 grid gap-10 lg:mt-16">
				{copy.sections.map((section) => (
					<section aria-labelledby={section.id}>
						<h2 id={section.id} class="mb-4 font-display text-lead leading-snug text-ink">
							{section.heading}
						</h2>
						<NewsProse body={section.body} />
					</section>
				))}
				<section aria-labelledby={copy.contact.id}>
					<h2 id={copy.contact.id} class="mb-4 font-display text-lead leading-snug text-ink">
						{copy.contact.heading}
					</h2>
					<div class="news-prose">
						<p>
							{copy.contact.before}
							<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
							{copy.contact.after}
						</p>
					</div>
				</section>
			</div>
		</div>
	</main>
	<SiteFooter />
</Layout>
