---
import Button from '../../components/Button.astro';
import NewsCard from '../../components/NewsCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { news, site } from '../../data/content';
import Layout from '../../layouts/Layout.astro';

// With no news the page stays as a short empty state (and is not indexed): a shared or bookmarked link, or a build
// that fell back to the committed snapshot, never lands on a 404.
const empty = news.length === 0;
---

<Layout
	title={`Novedades · ${site.name}`}
	description={`Avisos, resultados y noticias de ${site.name}, la asociación de estudiantes de Computación de la UNL.`}
	noindex={empty}
>
	<SiteHeader />
	<main id="contenido" class="bg-navy py-16 sm:py-24 lg:py-28">
		<div class="wrap">
			<SectionHead
				level={1}
				eyebrow="$ git tag --list"
				title="Novedades"
				lead={empty
					? 'Todavía no publicamos novedades. Mientras tanto, todo se anuncia en nuestras redes.'
					: 'Todo lo que hemos anunciado, de lo más nuevo a lo más antiguo.'}
			/>

			{
				empty ? (
					<div class="mt-12 flex flex-wrap gap-4 lg:mt-16">
						<Button href="/#redes">Ver redes</Button>
						<Button href="/" variant="ghost">Volver al inicio</Button>
					</div>
				) : (
					<ul class="mt-12 grid gap-4 lg:mt-16 xl:grid-cols-2 xl:gap-5">
						{news.map((item) => (
							<li class="min-w-0">
								<NewsCard item={item} variant="row" as="h2" />
							</li>
						))}
					</ul>
				)
			}
		</div>
	</main>
	<SiteFooter />
</Layout>
