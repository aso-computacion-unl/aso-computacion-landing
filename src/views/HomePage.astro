---
// The landing home in the language of the route that renders it (src/pages/index.astro, src/pages/en/index.astro).
import About from '../components/About.astro';
import ActivityGraph from '../components/ActivityGraph.astro';
import Board from '../components/Board.astro';
import Hero from '../components/Hero.astro';
import Join from '../components/Join.astro';
import News from '../components/News.astro';
import Registrations from '../components/Registrations.astro';
import Faq from '../components/Faq.astro';
import Forum from '../components/Forum.astro';
import Socials from '../components/Socials.astro';
import Sponsors from '../components/Sponsors.astro';
import Ribbon from '../components/Ribbon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';

const { faq, latestNews, site, socials, sponsors, team, timeline } = getContent(toLocale(Astro.currentLocale));
---

<Layout title={`${site.name} · ${site.tagline}`} description={site.description} events={timeline}>
	<SiteHeader />
	<main id="contenido">
		{/* Story first: who we are right after the hero, then the agenda (sign up, activities, news), then ask and meet us. */}
		<Hero />
		<Ribbon />
		<About />
		<Registrations />
		<ActivityGraph />
		{latestNews.length > 0 && <News />}
		<Forum />
		{team.length > 0 && <Board />}
		{(faq.items.length > 0 || faq.commands.length > 0) && <Faq />}
		<Join />
		{socials.length > 0 && <Socials />}
		<Sponsors sponsors={sponsors} />
	</main>
	<SiteFooter />
</Layout>
