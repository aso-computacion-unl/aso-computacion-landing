---
// The landing home in the language of the route that renders it (src/pages/index.astro, src/pages/en/index.astro).
import About from '../components/About.astro';
import ActivityGraph from '../components/ActivityGraph.astro';
import Board from '../components/Board.astro';
import Hero from '../components/Hero.astro';
import Join from '../components/Join.astro';
import News from '../components/News.astro';
import Faq from '../components/Faq.astro';
import Socials from '../components/Socials.astro';
import Ribbon from '../components/Ribbon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { getContent } from '../data/content';
import { toLocale } from '../i18n/locales';

const { faq, latestNews, site, socials, team } = getContent(toLocale(Astro.currentLocale));
---

<Layout title={`${site.name} · ${site.tagline}`} description={site.description}>
	<SiteHeader />
	<main id="contenido">
		<Hero />
		<Ribbon />
		<ActivityGraph />
		{latestNews.length > 0 && <News />}
		<About />
		{team.length > 0 && <Board />}
		<Join />
		{faq.items.length > 0 && <Faq />}
		{socials.length > 0 && <Socials />}
	</main>
	<SiteFooter />
</Layout>
