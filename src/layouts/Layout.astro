---
import '../styles/global.css';
import { getContent } from '../data/content';
import { alternatePath, defaultLocale, htmlLang, locales, toLocale } from '../i18n/locales';
import { buildSocialMeta } from '../lib/seo/meta';

interface Props {
	title: string;
	description: string;
	// Share image (absolute or site-relative URL), for pages that have their own picture. Without one, the brand's
	// default 1200x630 image is used.
	image?: string;
	type?: 'website' | 'article';
	// For pages that exist only as an empty state.
	noindex?: boolean;
}

const { title, description, image, type = 'website', noindex = false } = Astro.props;

const locale = toLocale(Astro.currentLocale);
// `site` is set in astro.config.mjs; every absolute URL of the page is built from it.
const site = Astro.site ?? new URL(Astro.url.origin);
const meta = buildSocialMeta({
	site,
	pathname: Astro.url.pathname,
	locale,
	title,
	description,
	siteName: getContent(locale).site.name,
	image,
	type,
});
// The same page in every language, absolute as hreflang asks for.
const alternateHref = (path: string) => new URL(path, site).href;
const alternates = locales.map((code) => ({ code, href: alternateHref(alternatePath(Astro.url.pathname, code)) }));
---

<!doctype html>
<html lang={htmlLang[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#053066" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={meta.canonical} />
		<meta property="og:type" content={meta.type} />
		<meta property="og:url" content={meta.url} />
		<meta property="og:site_name" content={meta.siteName} />
		<meta property="og:locale" content={meta.locale} />
		{meta.alternateLocales.map((code) => (
			<meta property="og:locale:alternate" content={code} />
		))}
		<meta property="og:title" content={meta.title} />
		<meta property="og:description" content={meta.description} />
		<meta property="og:image" content={meta.image} />
		{meta.imageSize && <meta property="og:image:width" content={String(meta.imageSize.width)} />}
		{meta.imageSize && <meta property="og:image:height" content={String(meta.imageSize.height)} />}
		<meta name="twitter:card" content={meta.twitterCard} />
		<meta name="twitter:title" content={meta.title} />
		<meta name="twitter:description" content={meta.description} />
		<meta name="twitter:image" content={meta.image} />
		{alternates.map((alternate) => (
			<link rel="alternate" hreflang={alternate.code} href={alternate.href} />
		))}
		<link rel="alternate" hreflang="x-default" href={alternateHref(alternatePath(Astro.url.pathname, defaultLocale))} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// Theme before the first paint, so there is no flash of the other one. Same rule as resolveTheme in
			// src/scripts/theme.ts: a stored choice wins, otherwise the system preference.
			(function () {
				let stored = null;
				try {
					stored = localStorage.getItem('aso-theme');
				} catch {
					// Storage blocked (private mode, policy): fall back to the system preference.
				}
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
				if (theme === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f4f7fb');
			})();
		</script>
		<script is:inline>
			// Opt in to the pre-motion state only when motion is allowed; fall back to visible if the motion script never starts.
			(function () {
				const root = document.documentElement;
				root.classList.add('js');
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				root.classList.add('motion');
				setTimeout(function () {
					if (!root.dataset.motionReady) root.classList.remove('motion');
				}, 5000);
			})();
		</script>
	</head>
	<body class="bg-navy font-sans text-ink antialiased">
		<slot />
		<script>
			import { initThemeToggle } from '../scripts/theme';
			import '../scripts/ui';

			initThemeToggle();
			import '../scripts/motion';
		</script>
	</body>
</html>
