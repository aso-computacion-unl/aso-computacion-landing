# Full URL of the admin's public content endpoint, read at BUILD time only.
# Unset (or unreachable/invalid) means the build uses src/data/fallback.json and never fails.
ADMIN_CONTENT_URL=https://your-admin.vercel.app/api/public/content

# Production content gate (see docs/DEPLOY.md). Builds on this Cloudflare Pages branch fail
# instead of shipping fallback/demo content; the previous deployment stays live.
# PRODUCTION_BRANCH=main
# Emergency only: downgrade the gate failure to a warning.
# ALLOW_CONTENT_FALLBACK=1

# Cloudflare Web Analytics beacon token (optional; leave unset if analytics is enabled
# in the Pages project settings instead).
# PUBLIC_CF_BEACON_TOKEN=

# Per-event registration with the open form (see docs/DEPLOY.md#event-registration): the PUBLIC site key of the
# Cloudflare Turnstile widget (the secret half is TURNSTILE_SECRET_KEY, in the admin). Not secret: it ends up in the page.
# Unset: events that use the open form show no form and the build prints a warning.
# PUBLIC_TURNSTILE_SITE_KEY=

# Preview build (see docs/DEPLOY.md#preview-builds): shows drafts and scheduled content, with a "Vista previa — no
# publicar" banner and noindex. Local or a separate, access-protected project ONLY; never the public one.
# PREVIEW_BUILD=1
# Name of the PUBLIC Cloudflare Pages project. Required for a preview build on Cloudflare Pages: the build fails if it
# runs on this project, or if this is unset. Ignored locally and in normal builds.
# PUBLIC_PAGES_PROJECT=aso-computacion-landing
# Code minted at <admin>/admin/vista-previa (secret, expires).
# PREVIEW_TOKEN=
# Must be https (http only for localhost).
# ADMIN_PREVIEW_URL=https://your-admin.vercel.app/api/public/preview
