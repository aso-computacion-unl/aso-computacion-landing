# Full URL of the admin's public content endpoint, read at BUILD time only.
# Unset (or unreachable/invalid) means the build uses src/data/fallback.json and never fails.
ADMIN_CONTENT_URL=https://your-admin.vercel.app/api/public/content

# Production content gate (see docs/DEPLOY.md). Builds on this Cloudflare Pages branch fail
# instead of shipping fallback/demo content; the previous deployment stays live.
# PRODUCTION_BRANCH=main
# Emergency only: downgrade the gate failure to a warning.
# ALLOW_CONTENT_FALLBACK=1

# Cloudflare Web Analytics beacon token (optional; leave unset if analytics is enabled
# in the Pages project settings instead).
# PUBLIC_CF_BEACON_TOKEN=
