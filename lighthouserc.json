{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec astro preview --ignore-lock --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "127.0.0.1:4321",
      "url": ["http://127.0.0.1:4321/", "http://127.0.0.1:4321/en/", "http://127.0.0.1:4321/novedades/"],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4321/(en/)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "/novedades/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.65, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
